{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "root": "apps/gateway",
  "sourceRoot": "apps/gateway/src",
  "compilerOptions": {
    "webpack": false,
    "tsConfigPath": "tsconfig.json"
  },
  "projects": {
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src"
    },
    "gateway": {
      "type": "application",
      "root": "apps/gateway",
      "entryFile": "main",
      "sourceRoot": "apps/gateway/src",
      "compilerOptions": {
        "tsConfigPath": "tsconfig.json"
      }
    },
    "ticket-service": {
      "type": "application",
      "root": "apps/ticket-service",
      "entryFile": "main",
      "sourceRoot": "apps/ticket-service/src",
      "compilerOptions": {
        "tsConfigPath": "tsconfig.json"
      }
    },
    "asset-service": {
      "type": "application",
      "root": "apps/asset-service",
      "entryFile": "main",
      "sourceRoot": "apps/asset-service/src",
      "compilerOptions": {
        "tsConfigPath": "tsconfig.json"
      }
    },
    "notification-worker": {
      "type": "application",
      "root": "apps/notification-worker",
      "entryFile": "main",
      "sourceRoot": "apps/notification-worker/src",
      "compilerOptions": {
        "tsConfigPath": "tsconfig.json"
      }
    }
  }
}
