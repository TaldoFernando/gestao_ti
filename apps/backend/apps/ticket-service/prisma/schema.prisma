generator client {
  provider      = "prisma-client-js"
  output        = "../../../node_modules/.prisma/ticket"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Status {
  ABERTO
  EM_ATENDIMENTO
  AGUARDANDO
  RESOLVIDO
}

enum Priority {
  BAIXA
  MEDIA
  ALTA
}

enum EventType {
  ABERTURA
  STATUS
  RESPOSTA
  NOTA
}

model Ticket {
  id            String       @id @default(uuid())
  // Código aleatório (não sequencial): ninguém consulta o chamado de outra pessoa trocando o número.
  protocol      String       @unique
  requesterName String
  email         String
  whatsapp      String
  // Referências ao asset-service, sem FK (database-per-service). O nome fica copiado para exibição.
  sectorId      String?
  sectorName    String?
  equipmentTag  String?
  title         String
  description   String
  status        Status       @default(ABERTO)
  priority      Priority     @default(MEDIA)
  assigneeId    String?
  assigneeName  String?
  events        TicketEvent[]
  attachments   Attachment[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status, createdAt])
}

model TicketEvent {
  id         String    @id @default(uuid())
  ticketId   String
  ticket     Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  type       EventType
  message    String
  // false = nota interna dos técnicos; o cidadão não vê.
  public     Boolean   @default(true)
  authorName String?
  createdAt  DateTime  @default(now())
}

model Attachment {
  id        String   @id @default(uuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  filename  String
  path      String
  mime      String
  size      Int
  createdAt DateTime @default(now())
}
